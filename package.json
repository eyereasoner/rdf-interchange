{
  "name": "rdf-interchange",
  "version": "0.1.4",
  "description": "Standalone RDF 1.2 interchange toolkit for ISO Prolog and eyemind.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": "./src/index.mjs",
  "bin": {
    "rdf-to-prolog": "./bin/rdf-to-prolog.js",
    "prolog-to-rdf": "./bin/prolog-to-rdf.js",
    "rdf-to-eyemind": "./bin/rdf-to-eyemind.js",
    "eyemind-to-rdf": "./bin/eyemind-to-rdf.js",
    "rdf-to-pl": "./bin/rdf-to-prolog.js",
    "pl-to-rdf": "./bin/prolog-to-rdf.js"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "EXTRACTION.md",
    "MAPPING.md",
    "why-rdf-prolog.md",
    "bin",
    "src",
    "examples",
    "test"
  ],
  "scripts": {
    "test": "node test/run.mjs && node test/examples-roundtrip.mjs",
    "test:core": "node test/run.mjs",
    "test:examples": "node test/examples-roundtrip.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Jos De Roo / extracted adapter packaging",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyereasoner/rdf-interchange.git"
  },
  "homepage": "https://github.com/eyereasoner/rdf-interchange#readme",
  "bugs": {
    "url": "https://github.com/eyereasoner/rdf-interchange/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "rdf-parse": "^5.0.0"
  }
}
